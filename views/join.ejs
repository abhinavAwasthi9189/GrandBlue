<!DOCTYPE html>
<html lang="en">
<head>
<%- include('_layout', { title: 'Join Group', page: 'groups' }) %>
  <% if (locals.error) { %>
    <div class="error-strip"><%= error %></div>
  <% } %>
  <% if (locals.success) { %>
    <div class="card" style="max-width:400px;margin:40px auto;text-align:center">
      <p style="color:var(--success);font-weight:600;margin-bottom:var(--space-md)"><%= success %></p>
      <a href="/group/<%= group_id %>" class="btn btn-primary">View group</a>
    </div>
  <% } %>
<%- include('_layout_close') %>