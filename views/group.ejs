<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head') %>
  <title>abs - <%= group.name %></title>
</head>
<body>
  <h1><%= group.name %></h1>

  <% if (!membership) { %>
    <p>You are not a member of this group.</p>
    <p><a href="/">Back to home</a></p>
  <% } else { %>
    <p>Your role: <strong><%= membership.role %></strong> | Status: <strong><%= membership.status %></strong></p>
    <p>
      <form method="POST" action="/group/<%= group.id %>/leave" style="display:inline">
        <button>Leave group</button>
      </form>
      <a href="/">Home</a>
    </p>

    <% if (membership.status === 'active') { %>
      <p><a href="/group/<%= group.id %>/history">Study history (past weeks)</a></p>

      <h2>Study timer</h2>
      <p id="timer-status">Loading…</p>
      <p>
        <button id="start-btn" type="button">Start studying</button>
        <button id="stop-btn" type="button" style="display:none">Stop</button>
      </p>
      <p><em>Session closes automatically after 3&nbsp;min without a heartbeat.</em></p>

      <h2>Notifications</h2>
      <p id="notif-status" style="color:#999">Loading…</p>
      <button id="notif-btn" type="button" style="display:none">Turn on notifications</button>

      <h2>Members</h2>
      <table border="1" cellpadding="4">
        <tr><th>Username</th><th>Status</th><th>This week</th><th>Role</th><th>Nudge</th>
          <% if (membership.role === 'admin') { %><th>Actions</th><% } %>
        </tr>
      <% members.forEach(function(m) { %>
        <tr data-user="<%= m.userId %>">
          <td><%= m.username %></td>
          <td class="status"></td>
          <td class="week"></td>
          <td><%= m.role %></td>
          <td>
            <% if (m.userId !== session.userId) { %>
              <button class="nudge-btn" data-user="<%= m.userId %>" type="button">Nudge</button>
              <span class="nudge-msg" style="color:red;font-size:0.9em"></span>
            <% } %>
          </td>
          <% if (membership.role === 'admin' && m.role !== 'admin') { %>
            <td>
              <form method="POST" action="/group/<%= group.id %>/remove/<%= m.userId %>" style="display:inline">
                <button>Remove</button>
              </form>
            </td>
          <% } else if (membership.role === 'admin') { %>
            <td></td>
          <% } %>
        </tr>
      <% }); %>
      </table>
    <% } else { %>
      <p><em>Waiting for admin approval.</em></p>
    <% } %>

    <% if (membership.role === 'admin' && membership.status === 'active') { %>
      <% if (pendingRequests.length > 0) { %>
        <h2>Pending requests</h2>
        <ul>
        <% pendingRequests.forEach(function(r) { %>
          <li>
            <strong><%= r.username %></strong>
            <form method="POST" action="/group/<%= group.id %>/approve/<%= r.id %>" style="display:inline">
              <button>Approve</button>
            </form>
            <form method="POST" action="/group/<%= group.id %>/reject/<%= r.id %>" style="display:inline">
              <button>Reject</button>
            </form>
          </li>
        <% }); %>
        </ul>
      <% } else { %>
        <p><em>No pending requests.</em></p>
      <% } %>

      <h2>Invite by username</h2>
      <form method="POST" action="/group/<%= group.id %>/invite">
        <input name="username" placeholder="Exact username" required>
        <button>Invite</button>
      </form>

      <h2>Invite links</h2>
      <p><a href="/invite-link/<%= group.id %>">Generate new invite link</a></p>
      <% if (locals.inviteLinks && inviteLinks.length > 0) { %>
        <ul>
        <% inviteLinks.forEach(function(link) { %>
          <li>Code: <code><%= link.code %></code> — <a href="/join/<%= link.code %>">/join/<%= link.code %></a> (expires <%= new Date(link.expires_at).toLocaleString() %>)</li>
        <% }); %>
        </ul>
      <% } %>

      <h2>Settings</h2>
      <form method="POST" action="/group/<%= group.id %>/settings">
        <p>Weekly quota (problems): <input name="weekly_quota" type="number" value="<%= group.weekly_quota %>" min="0"></p>
        <p><button>Save</button></p>
      </form>
    <% } %>

    <% if (locals.error) { %>
      <p style="color:red"><%= error %></p>
    <% } %>
  <% } %>

  <% if (membership && membership.status === 'active') { %>
  <script>
    (function() {
      var GROUP_ID = <%= group.id %>;
      var ME_ID = <%= session.userId %>;
      var GROUP_PATH = '/group/' + GROUP_ID;
      var members = <%- JSON.stringify(members).replace(/<\//g, '<\\/') %>;

      function fmtDur(ms) {
        if (ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        var h = Math.floor(s / 3600);
        var m = Math.floor((s % 3600) / 60);
        var sec = s % 60;
        if (h > 0) return h + 'h ' + m + 'm ' + sec + 's';
        if (m > 0) return m + 'm ' + sec + 's';
        return sec + 's';
      }

      function fmtAgo(ms) {
        if (ms == null) return 'never';
        var s = Math.floor(ms / 1000);
        if (s < 60) return s + 's ago';
        var m = Math.floor(s / 60);
        if (m < 60) return m + 'm ago';
        return Math.floor(m / 60) + 'h ' + (m % 60) + 'm ago';
      }

      var heartbeatTimer = null;

      function startHeartbeat() {
        if (heartbeatTimer) return;
        heartbeatTimer = setInterval(function() {
          fetch(GROUP_PATH + '/heartbeat', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (!d.ok) {
                clearInterval(heartbeatTimer);
                heartbeatTimer = null;
                // server likely closed the session; rely on next WS update
              }
            })
            .catch(function() {});
        }, 30000);
      }

      function stopHeartbeat() {
        if (heartbeatTimer) {
          clearInterval(heartbeatTimer);
          heartbeatTimer = null;
        }
      }

      function statusText(m) {
        if (m.studying) return 'Studying ' + fmtDur(Date.now() - m.startMs);
        return 'Last studied ' + fmtAgo(m.lastEndMs == null ? null : Date.now() - m.lastEndMs);
      }

      function render() {
        var me = null;
        for (var i = 0; i < members.length; i++) {
          var m = members[i];
          if (m.userId === ME_ID) me = m;
          var row = document.querySelector('tr[data-user="' + m.userId + '"]');
          if (!row) continue;
          var statusEl = row.querySelector('.status');
          if (statusEl) statusEl.textContent = statusText(m);
          var weekEl = row.querySelector('.week');
          if (weekEl) weekEl.textContent = fmtDur(m.weekTotalMs);
          var nudgeBtn = row.querySelector('.nudge-btn');
          if (nudgeBtn) nudgeBtn.style.display = m.studying ? 'none' : 'inline';
        }
        if (me) {
          document.getElementById('timer-status').textContent = me.studying
            ? 'You are studying. ' + fmtDur(Date.now() - me.startMs)
            : 'Not studying.';
          document.getElementById('start-btn').style.display = me.studying ? 'none' : 'inline';
          document.getElementById('stop-btn').style.display = me.studying ? 'inline' : 'none';
          if (me.studying && !heartbeatTimer) startHeartbeat();
          if (!me.studying && heartbeatTimer) stopHeartbeat();
        }
      }

      function connect() {
        var proto = location.protocol === 'https:' ? 'wss' : 'ws';
        var ws = new WebSocket(proto + '://' + location.host + '/ws/group/' + GROUP_ID);
        ws.onmessage = function(e) {
          var msg = JSON.parse(e.data);
          if (msg.type === 'state') {
            members = msg.members;
          } else if (msg.type === 'update') {
            var found = false;
            for (var i = 0; i < members.length; i++) {
              if (members[i].userId === msg.member.userId) {
                members[i] = msg.member;
                found = true;
                break;
              }
            }
            if (!found) members.push(msg.member);
          }
          render();
        };
        ws.onclose = function() {
          setTimeout(connect, 3000);
        };
      }

      document.getElementById('start-btn').addEventListener('click', function() {
        fetch(GROUP_PATH + '/start', { method: 'POST' }).catch(function() {});
      });
      document.getElementById('stop-btn').addEventListener('click', function() {
        fetch(GROUP_PATH + '/stop', { method: 'POST' }).catch(function() {});
      });

      // --- Nudge buttons ---
      document.querySelectorAll('.nudge-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetId = btn.getAttribute('data-user');
          var msgEl = btn.parentElement.querySelector('.nudge-msg');
          msgEl.textContent = '';
          fetch(GROUP_PATH + '/nudge/' + targetId, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (d.ok) {
                msgEl.style.color = 'green';
                msgEl.textContent = 'Nudged!';
              } else {
                msgEl.style.color = 'red';
                msgEl.textContent = d.error || 'Failed';
              }
              setTimeout(function() { msgEl.textContent = ''; }, 4000);
            })
            .catch(function() {});
        });
      });

      // --- Notifications ---
      var notifStatus = document.getElementById('notif-status');
      var notifBtn = document.getElementById('notif-btn');
      var vapidAvailable = false;

      function updateNotifUI(subscribed) {
        if (!('Notification' in window)) {
          notifStatus.textContent = 'Notifications not supported';
          notifBtn.style.display = 'none';
          return;
        }
        if (!vapidAvailable) {
          notifStatus.textContent = 'VAPID not configured on server (set VAPID_PUBLIC_KEY env)';
          notifBtn.style.display = 'none';
          return;
        }
        if (Notification.permission === 'denied') {
          notifStatus.textContent = 'Notifications blocked - enable in browser settings';
          notifBtn.style.display = 'none';
        } else if (subscribed) {
          notifStatus.textContent = 'Notifications on';
          notifBtn.textContent = 'Resubscribe';
          notifBtn.style.display = 'inline';
        } else {
          notifStatus.textContent = Notification.permission === 'granted' ? 'Notifications off (resubscribe below)' : 'Notifications off';
          notifBtn.textContent = 'Turn on notifications';
          notifBtn.style.display = 'inline';
        }
      }

      notifBtn.addEventListener('click', function() {
        if (Notification.permission === 'granted') {
          subscribeForPush();
        } else {
          Notification.requestPermission().then(function(perm) {
            if (perm === 'granted') subscribeForPush();
            updateNotifUI(false);
          });
        }
      });

      function subscribeForPush() {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
        navigator.serviceWorker.register('/sw.js').then(function(reg) {
          fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
            if (!d.key) return;
            vapidAvailable = true;
            var raw = d.key.replace(/-/g, '+').replace(/_/g, '/');
            while (raw.length % 4) raw += '=';
            var u = new Uint8Array(atob(raw).split('').map(function(c) { return c.charCodeAt(0); }));
            reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: u })
              .then(function(sub) {
                fetch('/push/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ endpoint: sub.endpoint, keys: sub.toJSON().keys }),
                }).then(function() {
                  updateNotifUI(true);
                }).catch(function() {
                  notifStatus.textContent = 'Failed to save subscription';
                });
              }).catch(function(e) {
                notifStatus.textContent = 'Subscription failed: ' + e.message;
              });
          });
        });
      }

      // prime vapidAvailable on page load
      fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
        vapidAvailable = !!d.key;
        updateNotifUI(false);
      }).catch(function() {
        notifStatus.textContent = 'Could not check push config';
      });

      setInterval(render, 1000);
      render();
      connect();
    })();
  </script>
  <% } %>
</body>
</html>