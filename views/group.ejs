<!DOCTYPE html>
<html lang="en">
<head>
<%- include('_layout', { title: group.name, page: 'groups', wide: true }) %>
  <% if (locals.error) { %>
    <div class="error-strip"><%= error %></div>
  <% } %>

  <div class="header-bar" style="margin-bottom:var(--space-md)">
    <div style="display:flex;align-items:center;gap:var(--space-md);min-width:0">
      <a href="/" class="btn-back" style="font-size:1.2rem;text-decoration:none;color:var(--text-secondary)">←</a>
      <h1 style="font-size:var(--font-xl);font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= group.name %></h1>
    </div>
    <div class="header-actions">
      <% if (membership && membership.role === 'admin') { %>
        <a href="/group/<%= group.id %>/settings" class="btn-back" style="font-size:1.2rem;text-decoration:none;color:var(--text-secondary)" title="Group settings">⚙</a>
      <% } else if (membership) { %>
        <button class="btn-back" id="leave-menu-btn" type="button" style="font-size:1.2rem;background:none;border:none;color:var(--text-secondary);cursor:pointer">⋯</button>
      <% } %>
    </div>
  </div>

  <% if (!membership) { %>
    <div class="empty-state"><div class="empty-state-text">You are not a member of this group.</div></div>
    <p style="text-align:center;margin-top:var(--space-md)"><a href="/" class="btn btn-secondary">Back to home</a></p>
  <% } else if (membership.status !== 'active') { %>
    <div class="empty-state"><div class="empty-state-text">Waiting for admin approval.</div></div>
  <% } else { %>

    <!-- Start / Stop bar -->
    <div class="card" style="margin-bottom:var(--space-md);display:flex;align-items:center;justify-content:space-between;gap:var(--space-md)">
      <div>
        <div id="timer-status" style="font-weight:600">Loading…</div>
        <div id="timer-sub" style="font-size:var(--font-sm);color:var(--text-tertiary);margin-top:var(--space-xs)">
        </div>
      </div>
      <div style="display:flex;gap:var(--space-sm);flex-shrink:0">
        <button id="start-btn" class="btn btn-primary" type="button">Start studying</button>
        <button id="stop-btn" class="btn btn-danger" type="button" style="display:none">Stop</button>
      </div>
    </div>

    <!-- Top tabs -->
    <div style="display:flex;gap:1px;margin-bottom:var(--space-lg);background:var(--bg-tertiary);border-radius:var(--radius-md);overflow:hidden">
      <a href="/group/<%= group.id %>" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-card);padding:10px;text-decoration:none;font-weight:500">Members</a>
      <a href="/group/<%= group.id %>/study" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-tertiary);padding:10px;text-decoration:none;color:var(--text-secondary)">Study</a>
      <a href="/group/<%= group.id %>/leetwars" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-tertiary);padding:10px;text-decoration:none;color:var(--text-secondary)">Leetwars</a>
    </div>

    <!-- Members tab content -->
    <div id="members-tab">
      <% members.forEach(function(m) { %>
          <div class="list-row" data-user="<%= m.userId %>">
          <% if (m.hasAvatar) { %>
            <img class="avatar" src="/avatar/<%= m.userId %>" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover">
          <% } else { %>
          <div class="avatar" style="background:<%= m.color %>"><%= m.username.charAt(0).toUpperCase() %></div>
          <% } %>
          <div class="row-main">
            <div class="row-label">
              <%= m.username %>
              <% if (m.role === 'admin') { %><span class="chip chip-accent" style="font-size:10px;padding:1px 6px">Admin</span><% } %>
            </div>
            <div class="row-sub">
              <span class="status"></span>
              <span class="week" style="margin-left:var(--space-sm)"></span>
            </div>
          </div>
          <span class="live-timer" style="display:none;font-family:var(--font-mono);font-weight:700;font-size:var(--font-base);color:var(--accent);white-space:nowrap;margin-right:var(--space-sm);min-width:70px;text-align:right"></span>
          <% if (m.userId !== session.userId) { %>
            <button class="nudge-btn btn btn-sm btn-secondary" data-user="<%= m.userId %>" type="button">Nudge</button>
            <span class="nudge-msg" style="font-size:var(--font-sm);color:var(--danger)"></span>
            <% if (membership.role === 'admin' && m.role !== 'admin') { %>
              <button class="btn btn-sm btn-ghost remove-member-btn" data-user="<%= m.userId %>" data-name="<%= m.username %>" type="button" style="color:var(--danger);font-size:var(--font-sm)">Remove</button>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- Admin sections -->
    <% if (membership.role === 'admin') { %>
      <% if (pendingRequests.length > 0) { %>
        <div style="margin-top:var(--space-lg)">
          <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">Join requests</h2>
          <% pendingRequests.forEach(function(r) { %>
            <div class="list-row">
              <div class="row-main"><div class="row-label"><%= r.username %></div></div>
              <form method="POST" action="/group/<%= group.id %>/approve/<%= r.id %>" style="display:inline"><button class="btn btn-sm btn-primary">Approve</button></form>
              <form method="POST" action="/group/<%= group.id %>/reject/<%= r.id %>" style="display:inline"><button class="btn btn-sm btn-secondary">Reject</button></form>
            </div>
          <% }); %>
        </div>
      <% } %>

      <div style="margin-top:var(--space-lg)">
        <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">Invite</h2>
        <form method="POST" action="/group/<%= group.id %>/invite" style="display:flex;gap:var(--space-sm);margin-bottom:var(--space-md)">
          <input name="username" placeholder="Exact username" required
            style="flex:1;padding:10px 12px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px">
          <button class="btn btn-sm btn-primary">Invite</button>
        </form>

        <div class="card" style="margin-bottom:var(--space-md)">
          <div style="font-size:var(--font-sm);font-weight:600;margin-bottom:var(--space-sm)">Invite link / code</div>
          <% if (locals.inviteLinks && inviteLinks.length > 0) { %>
            <% inviteLinks.forEach(function(link) { %>
              <div style="display:flex;align-items:center;gap:var(--space-sm);margin-bottom:var(--space-sm);font-size:var(--font-sm)">
                <code style="flex:1;padding:6px 10px;background:var(--bg-tertiary);border-radius:var(--radius-sm);font-family:var(--font-mono)"><%= link.code %></code>
                <button class="btn btn-sm btn-ghost copy-code-btn" data-code="<%= link.code %>" type="button">Copy</button>
              </div>
            <% }); %>
          <% } else { %>
            <p style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-sm)">No active invite links.</p>
          <% } %>
          <a href="/invite-link/<%= group.id %>" class="btn btn-sm btn-secondary">Generate new link</a>
        </div>
      </div>

      <div style="margin-top:var(--space-lg);text-align:center">
        <button class="btn btn-danger" id="leave-group-btn" type="button">Leave group</button>
      </div>
    <% } else { %>
      <div style="margin-top:var(--space-lg);text-align:center">
        <button class="btn btn-danger" id="leave-group-btn" type="button">Leave group</button>
      </div>
    <% } %>

  <% } %>

  <!-- Leave confirmation dialog -->
  <div class="dialog-overlay" id="leave-dialog" style="display:none">
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-title">Leave group?</div>
        <button class="dialog-close" id="leave-dialog-close">✕</button>
      </div>
      <p style="margin-bottom:var(--space-lg);color:var(--text-secondary);font-size:var(--font-sm)">You won't be able to access this group's data after leaving.</p>
      <div class="dialog-actions">
        <button class="btn btn-secondary" id="leave-dialog-cancel">Cancel</button>
        <form method="POST" action="/group/<%= group.id %>/leave" style="flex:1">
          <button class="btn btn-danger" style="width:100%">Leave</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Remove member confirmation dialog -->
  <div class="dialog-overlay" id="remove-dialog" style="display:none">
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-title">Remove member</div>
        <button class="dialog-close" id="remove-dialog-close">✕</button>
      </div>
      <p style="margin-bottom:var(--space-lg);color:var(--text-secondary);font-size:var(--font-sm)">Remove <strong id="remove-name"></strong> from this group?</p>
      <div class="dialog-actions">
        <button class="btn btn-secondary" id="remove-dialog-cancel">Cancel</button>
        <form method="POST" id="remove-form" style="flex:1">
          <button class="btn btn-danger" style="width:100%">Remove</button>
        </form>
      </div>
    </div>
  </div>

  <% if (membership && membership.status === 'active') { %>
  <div id="members-data" style="display:none" data-members='<%= JSON.stringify(members) %>' data-group-id="<%= group.id %>" data-me-id="<%= session.userId %>"></div>

  <!-- Stop-with-time-picker dialog -->
  <div class="dialog-overlay" id="stop-dialog" style="display:none">
    <div class="dialog-content">
      <div class="dialog-header">
        <div class="dialog-title">Did you stop earlier?</div>
        <button class="dialog-close" id="stop-dialog-close">✕</button>
      </div>
      <p style="margin-bottom:var(--space-md);color:var(--text-secondary);font-size:var(--font-sm)">Set the time you stopped studying:</p>
      <input type="datetime-local" id="stop-end-time" style="width:100%;padding:10px 12px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px;margin-bottom:var(--space-md)">
      <div class="dialog-actions">
        <button class="btn btn-secondary" id="stop-dialog-cancel">Cancel</button>
        <button class="btn btn-danger" id="stop-dialog-confirm">Stop</button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var dataEl = document.getElementById('members-data');
      var GROUP_ID = parseInt(dataEl.dataset.groupId, 10);
      var ME_ID = parseInt(dataEl.dataset.meId, 10);
      var GROUP_PATH = '/group/' + GROUP_ID;
      var members = JSON.parse(dataEl.dataset.members);

      var serverNowMs = null;
      var serverNowReceivedAt = null;

      function fmtDur(ms) {
        if (ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        var h = Math.floor(s / 3600);
        var m = Math.floor((s % 3600) / 60);
        var sec = s % 60;
        if (h > 0) return h + 'h ' + m + 'm ' + sec + 's';
        if (m > 0) return m + 'm ' + sec + 's';
        return sec + 's';
      }

      function elapsedSince(startMs) {
        if (serverNowMs === null) return Date.now() - startMs;
        return (serverNowMs - startMs) + (Date.now() - serverNowReceivedAt);
      }

      var heartbeatTimer = null;

      function startHeartbeat() {
        if (heartbeatTimer) return;
        heartbeatTimer = setInterval(function() {
          fetch(GROUP_PATH + '/heartbeat', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (!d.ok) { clearInterval(heartbeatTimer); heartbeatTimer = null; }
            })
            .catch(function() {});
        }, 30000);
      }

      function stopHeartbeat() {
        if (heartbeatTimer) { clearInterval(heartbeatTimer); heartbeatTimer = null; }
      }

      function statusText(m) {
        if (!m.studying) return '';
        if (m.lastHeartbeatMs && serverNowMs && (serverNowMs - m.lastHeartbeatMs) > 600000) {
          return 'Studying · away';
        }
        return 'Studying';
      }

      function showToast(text) {
        var t = document.createElement('div');
        t.className = 'toast';
        t.textContent = text;
        t.style.cssText = 'position:fixed;bottom:calc(var(--tab-bar-height) + var(--safe-bottom) + var(--space-lg));left:50%;transform:translateX(-50%);z-index:2000;background:var(--bg-elevated);color:var(--text-primary);border:1px solid var(--border);border-radius:var(--radius-md);padding:var(--space-md) var(--space-lg);box-shadow:var(--shadow-lg);font-size:var(--font-sm);font-weight:500;max-width:90vw';
        document.body.appendChild(t);
        setTimeout(function() { t.remove(); }, 4000);
      }

      var wakeLock = null;

      function requestWakeLock() {
        if ('wakeLock' in navigator) {
          try {
            navigator.wakeLock.request('screen').then(function(lock) {
              wakeLock = lock;
            }).catch(function() {});
          } catch(e) {}
        }
      }

      function releaseWakeLock() {
        if (wakeLock) { wakeLock.release().catch(function() {}); wakeLock = null; }
      }

      function render() {
        var me = null;
        var container = document.getElementById('members-tab');
        var rows = Array.from(container.querySelectorAll('.list-row'));

        var sortedIds = members.slice().sort(function(a, b) {
          if (a.studying && !b.studying) return -1;
          if (!a.studying && b.studying) return 1;
          return a.username < b.username ? -1 : 1;
        }).map(function(m) { return m.userId; });

        var currentOrder = rows.map(function(r) { return Number(r.dataset.user); });
        var needsReorder = false;
        for (var si = 0; si < sortedIds.length; si++) {
          if (currentOrder[si] !== sortedIds[si]) { needsReorder = true; break; }
        }
        if (needsReorder) {
          sortedIds.forEach(function(id) {
            var r = container.querySelector('[data-user="' + id + '"]');
            if (r) container.appendChild(r);
          });
        }

        for (var i = 0; i < members.length; i++) {
          var m = members[i];
          if (m.userId === ME_ID) me = m;
          var row = document.querySelector('[data-user="' + m.userId + '"]');
          if (!row) continue;
          var statusEl = row.querySelector('.status');
          if (statusEl) {
            var txt = statusText(m);
            statusEl.textContent = txt;
            if (txt.indexOf('away') !== -1) {
              statusEl.style.color = 'var(--text-tertiary)';
            } else {
              statusEl.style.color = '';
            }
          }
          var weekEl = row.querySelector('.week');
          if (weekEl) weekEl.textContent = fmtDur(m.weekTotalMs) + ' this week';
          row.classList.toggle('studying', m.studying);
          var nudgeBtn = row.querySelector('.nudge-btn');
          if (nudgeBtn) nudgeBtn.style.display = m.studying ? 'none' : 'inline-flex';
          var timerEl = row.querySelector('.live-timer');
          if (timerEl) {
            if (m.studying) {
              timerEl.style.display = 'inline';
              timerEl.textContent = fmtDur(elapsedSince(m.startMs));
            } else {
              timerEl.style.display = 'none';
            }
          }
        }
        if (me) {
          var studying = me.studying;
          document.getElementById('timer-status').textContent = studying
            ? 'Studying · ' + fmtDur(elapsedSince(me.startMs))
            : 'Not studying';
          document.getElementById('start-btn').style.display = studying ? 'none' : 'inline-flex';
          document.getElementById('stop-btn').style.display = studying ? 'inline-flex' : 'none';
          if (studying && !heartbeatTimer) startHeartbeat();
          if (!studying && heartbeatTimer) stopHeartbeat();
          if (studying && window.absMiniTimer) {
            window.absMiniTimer.show(me.startMs, GROUP_ID, serverNowMs, serverNowReceivedAt);
          } else if (!studying && window.absMiniTimer) {
            window.absMiniTimer.hide();
          }
          // Wake lock
          if (studying && !wakeLock) requestWakeLock();
          if (!studying && wakeLock) releaseWakeLock();
        }
      }

      var reconnectStrip = null;

      function showReconnecting(show) {
        if (!reconnectStrip) {
          reconnectStrip = document.createElement('div');
          reconnectStrip.className = 'reconnecting';
          reconnectStrip.textContent = 'Reconnecting…';
          var main = document.querySelector('.app-main');
          if (main) main.parentNode.insertBefore(reconnectStrip, main);
        }
        reconnectStrip.style.display = show ? '' : 'none';
      }

      var wsReconnectDelay = 1000;

      function connect() {
        var proto = location.protocol === 'https:' ? 'wss' : 'ws';
        var ws = new WebSocket(proto + '://' + location.host + '/ws/group/' + GROUP_ID);
        ws.onopen = function() {
          showReconnecting(false);
          wsReconnectDelay = 1000;
        };
        ws.onmessage = function(e) {
          var msg = JSON.parse(e.data);
          if (msg.server_now_ms !== undefined) {
            serverNowMs = msg.server_now_ms;
            serverNowReceivedAt = Date.now();
          }
          if (msg.type === 'state') { members = msg.members; }
          else if (msg.type === 'update') {
            var found = false;
            for (var i = 0; i < members.length; i++) {
              if (members[i].userId === msg.member.userId) { members[i] = msg.member; found = true; break; }
            }
            if (!found) members.push(msg.member);
          } else if (msg.type === 'nudge' && msg.targetUserId === ME_ID) {
            showToast(msg.fromUsername + ' nudged you!', 'nudge');
          }
          render();
        };
        ws.onclose = function() {
          showReconnecting(true);
          var delay = wsReconnectDelay;
          wsReconnectDelay = Math.min(wsReconnectDelay * 2, 30000);
          setTimeout(connect, delay);
          fetchSessionAndRender();
        };
      }

      function fetchSessionAndRender() {
        fetch('/api/session/current')
          .then(function(r) { return r.json(); })
          .then(function(d) {
            if (d.server_now_ms !== undefined) {
              serverNowMs = d.server_now_ms;
              serverNowReceivedAt = Date.now();
            }
            if (d.session) {
              var me = members.filter(function(m) { return m.userId === ME_ID; })[0];
              if (me) {
                me.studying = true;
                me.startMs = d.session.start_ms;
                me.lastHeartbeatMs = d.session.last_heartbeat_ms;
                render();
              }
            }
          })
          .catch(function() {});
      }

      document.getElementById('start-btn').addEventListener('click', function() {
        fetch(GROUP_PATH + '/start', { method: 'POST' }).catch(function() {});
      });

      document.getElementById('stop-btn').addEventListener('click', function() {
        var me = members.filter(function(m) { return m.userId === ME_ID; })[0];
        if (!me || !me.studying) return;
        var elapsed = elapsedSince(me.startMs);
        if (elapsed >= 10800000) {
          showStopDialog(me.startMs);
        } else {
          fetch(GROUP_PATH + '/stop', { method: 'POST' }).catch(function() {});
        }
      });

      function showStopDialog(startMs) {
        var dialog = document.getElementById('stop-dialog');
        var input = document.getElementById('stop-end-time');
        var now = new Date();
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        var nowStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
        input.value = nowStr;
        var minDate = new Date(startMs + 60000);
        var minStr = minDate.getFullYear() + '-' + pad(minDate.getMonth()+1) + '-' + pad(minDate.getDate()) + 'T' + pad(minDate.getHours()) + ':' + pad(minDate.getMinutes());
        input.min = minStr;
        input.max = nowStr;
        dialog.style.display = 'flex';
      }

      document.getElementById('stop-dialog-close').addEventListener('click', function() {
        document.getElementById('stop-dialog').style.display = 'none';
      });
      document.getElementById('stop-dialog-cancel').addEventListener('click', function() {
        document.getElementById('stop-dialog').style.display = 'none';
      });
      document.getElementById('stop-dialog-confirm').addEventListener('click', function() {
        var input = document.getElementById('stop-end-time');
        var val = input.value;
        var endMs = new Date(val).getTime();
        if (isNaN(endMs)) return;
        fetch(GROUP_PATH + '/stop', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'endMs=' + endMs
        }).catch(function() {});
        document.getElementById('stop-dialog').style.display = 'none';
      });

      // Nudge
      document.querySelectorAll('.nudge-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetId = btn.getAttribute('data-user');
          var msgEl = btn.parentElement.querySelector('.nudge-msg');
          msgEl.textContent = '';
          fetch(GROUP_PATH + '/nudge/' + targetId, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (d.ok) {
                if (d.noPush) {
                  msgEl.style.color = 'var(--warning)';
                  msgEl.textContent = d.targetName + " hasn't turned on notifications";
                } else {
                  msgEl.style.color = 'var(--success)';
                  msgEl.textContent = 'Nudged!';
                }
              } else { msgEl.style.color = 'var(--danger)'; msgEl.textContent = d.error || 'Failed'; }
              setTimeout(function() { msgEl.textContent = ''; }, 4000);
            })
            .catch(function() {});
        });
      });

      // Reconnect / refetch on visibilitychange, pageshow, online
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) {
          connect();
          fetchSessionAndRender();
          if (wakeLock === null) requestWakeLock();
        }
      });
      window.addEventListener('pageshow', function() {
        connect();
        fetchSessionAndRender();
      });
      window.addEventListener('online', function() {
        connect();
        fetchSessionAndRender();
      });

      var renderInterval = setInterval(render, 1000);
      render();
      connect();
      fetchSessionAndRender();

      // --- Dialogs ---
      var leaveDialog = document.getElementById('leave-dialog');
      document.getElementById('leave-group-btn').addEventListener('click', function() { leaveDialog.style.display = 'flex'; });
      document.getElementById('leave-dialog-close').addEventListener('click', function() { leaveDialog.style.display = 'none'; });
      document.getElementById('leave-dialog-cancel').addEventListener('click', function() { leaveDialog.style.display = 'none'; });
      leaveDialog.addEventListener('click', function(e) { if (e.target === leaveDialog) leaveDialog.style.display = 'none'; });

      var removeDialog = document.getElementById('remove-dialog');
      document.querySelectorAll('.remove-member-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.getElementById('remove-name').textContent = btn.getAttribute('data-name');
          document.getElementById('remove-form').action = '/group/' + GROUP_ID + '/remove/' + btn.getAttribute('data-user');
          removeDialog.style.display = 'flex';
        });
      });
      document.getElementById('remove-dialog-close').addEventListener('click', function() { removeDialog.style.display = 'none'; });
      document.getElementById('remove-dialog-cancel').addEventListener('click', function() { removeDialog.style.display = 'none'; });
      removeDialog.addEventListener('click', function(e) { if (e.target === removeDialog) removeDialog.style.display = 'none'; });

      // Copy invite code
      document.querySelectorAll('.copy-code-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var code = btn.getAttribute('data-code');
          if (navigator.clipboard) {
            navigator.clipboard.writeText(code).then(function() {
              btn.textContent = 'Copied!';
              setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
            }).catch(function() {});
          } else {
            var ta = document.createElement('textarea');
            ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta);
            btn.textContent = 'Copied!';
            setTimeout(function() { btn.textContent = 'Copy'; }, 2000);
          }
        });
      });
    })();
  </script>
  <% } %>
