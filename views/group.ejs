<!DOCTYPE html>
<html lang="en">
<head>
<%- include('_layout', { title: group.name, page: 'groups', wide: true }) %>
  <% if (locals.error) { %>
    <div class="error-strip"><%= error %></div>
  <% } %>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-lg)">
    <div style="display:flex;align-items:center;gap:var(--space-md)">
      <a href="/" class="btn btn-ghost btn-sm" style="font-size:1.2rem;padding:4px 8px">←</a>
      <h1 style="font-size:var(--font-xl);font-weight:700"><%= group.name %></h1>
    </div>
    <% if (membership && membership.role === 'admin') { %>
      <span class="chip chip-accent">Admin</span>
    <% } %>
  </div>

  <% if (!membership) { %>
    <div class="empty-state"><div class="empty-state-text">You are not a member of this group.</div></div>
    <p style="text-align:center;margin-top:var(--space-md)"><a href="/" class="btn btn-secondary">Back to home</a></p>
  <% } else { %>
    <% if (membership.status === 'active') { %>

      <!-- Study timer + Notifications -->
      <div class="card" style="margin-bottom:var(--space-md)">
        <div style="display:flex;align-items:center;justify-content:space-between">
          <div><span id="timer-status">Loading…</span></div>
          <div style="display:flex;gap:var(--space-sm)">
            <button id="start-btn" class="btn btn-primary btn-sm" type="button">Start studying</button>
            <button id="stop-btn" class="btn btn-danger btn-sm" type="button" style="display:none">Stop</button>
          </div>
        </div>
        <div style="margin-top:var(--space-sm);display:flex;align-items:center;gap:var(--space-md)">
          <span id="notif-status" style="font-size:var(--font-sm);color:var(--text-tertiary)">Loading…</span>
          <button id="notif-btn" class="btn btn-sm btn-secondary" type="button" style="display:none">Turn on notifications</button>
        </div>
      </div>

      <!-- Top tabs -->
      <div style="display:flex;gap:1px;margin-bottom:var(--space-lg);background:var(--bg-tertiary);border-radius:var(--radius-md);overflow:hidden">
        <a href="/group/<%= group.id %>" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-card);padding:10px;text-decoration:none;font-weight:500">Members</a>
        <a href="/group/<%= group.id %>/history" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-tertiary);padding:10px;text-decoration:none;color:var(--text-secondary)">Study</a>
        <a href="/group/<%= group.id %>/leetwars" class="btn btn-sm" style="flex:1;border-radius:0;background:var(--bg-tertiary);padding:10px;text-decoration:none;color:var(--text-secondary)">Leetwars</a>
      </div>

      <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">Members</h2>
      <% members.forEach(function(m) { %>
        <div class="list-row" data-user="<%= m.userId %>">
          <% var hash = 0; for (var i = 0; i < String(m.userId).length; i++) { hash = ((hash << 5) - hash) + String(m.userId).charCodeAt(i); hash |= 0; } %>
          <% var hue = ((hash % 360) + 360) % 360; %>
          <div class="avatar" style="background:hsl(<%= hue %>, 55%, 50%)"><%= m.username.charAt(0).toUpperCase() %></div>
          <div class="row-main">
            <div class="row-label"><%= m.username %> <% if (m.role === 'admin') { %><span class="chip chip-accent" style="font-size:10px;padding:1px 6px">Admin</span><% } %></div>
            <div class="row-sub">
              <span class="status"></span> · <span class="week"></span>
            </div>
          </div>
          <% if (m.userId !== session.userId) { %>
            <button class="nudge-btn btn btn-sm btn-secondary" data-user="<%= m.userId %>" type="button">Nudge</button>
            <span class="nudge-msg" style="font-size:var(--font-sm);color:var(--danger)"></span>
          <% } %>
        </div>
      <% }); %>

      <% if (membership.role === 'admin') { %>
        <% if (pendingRequests.length > 0) { %>
          <h2 style="font-size:var(--font-lg);font-weight:600;margin:var(--space-lg) 0 var(--space-md)">Join requests</h2>
          <% pendingRequests.forEach(function(r) { %>
            <div class="list-row">
              <div class="row-main"><div class="row-label"><%= r.username %></div></div>
              <form method="POST" action="/group/<%= group.id %>/approve/<%= r.id %>" style="display:inline"><button class="btn btn-sm btn-primary">Approve</button></form>
              <form method="POST" action="/group/<%= group.id %>/reject/<%= r.id %>" style="display:inline"><button class="btn btn-sm btn-secondary">Reject</button></form>
            </div>
          <% }); %>
        <% } %>

        <div class="card" style="margin-top:var(--space-lg)">
          <h3 style="font-size:var(--font-base);font-weight:600;margin-bottom:var(--space-md)">Invite by username</h3>
          <form method="POST" action="/group/<%= group.id %>/invite" style="display:flex;gap:var(--space-sm)">
            <input name="username" placeholder="Exact username" required
              style="flex:1;padding:10px 12px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px">
            <button class="btn btn-sm btn-primary">Invite</button>
          </form>
        </div>

        <div class="card" style="margin-top:var(--space-md)">
          <h3 style="font-size:var(--font-base);font-weight:600;margin-bottom:var(--space-md)">Invite links</h3>
          <p style="margin-bottom:var(--space-sm)"><a href="/invite-link/<%= group.id %>" class="btn btn-sm btn-secondary">Generate new link</a></p>
          <% if (locals.inviteLinks && inviteLinks.length > 0) { %>
            <% inviteLinks.forEach(function(link) { %>
              <div class="list-row" style="font-size:var(--font-sm)">
                <code><%= link.code %></code>
                <span class="text-secondary"><%= new Date(link.expires_at).toLocaleDateString() %></span>
              </div>
            <% }); %>
          <% } %>
        </div>

        <div class="card" style="margin-top:var(--space-md);margin-bottom:var(--space-lg)">
          <h3 style="font-size:var(--font-base);font-weight:600;margin-bottom:var(--space-md)">Settings</h3>
          <form method="POST" action="/group/<%= group.id %>/settings">
            <div style="margin-bottom:var(--space-md)">
              <label style="font-size:var(--font-sm);color:var(--text-secondary);display:block;margin-bottom:var(--space-xs)">Weekly quota (problems)</label>
              <input name="weekly_quota" type="number" value="<%= group.weekly_quota %>" min="0"
                style="width:100%;padding:10px 12px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px">
            </div>
            <button class="btn btn-primary">Save</button>
          </form>
        </div>
      <% } else { %>
        <div style="text-align:center;margin-top:var(--space-lg)">
          <form method="POST" action="/group/<%= group.id %>/leave"><button class="btn btn-danger">Leave group</button></form>
        </div>
      <% } %>

    <% } else { %>
      <div class="empty-state"><div class="empty-state-text">Waiting for admin approval.</div></div>
    <% } %>
  <% } %>

  <% if (membership && membership.status === 'active') { %>
  <script>
    (function() {
      var GROUP_ID = <%= group.id %>;
      var ME_ID = <%= session.userId %>;
      var GROUP_PATH = '/group/' + GROUP_ID;
      var members = <%- JSON.stringify(members).replace(/<\//g, '<\\/') %>;

      function fmtDur(ms) {
        if (ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        var h = Math.floor(s / 3600);
        var m = Math.floor((s % 3600) / 60);
        var sec = s % 60;
        if (h > 0) return h + 'h ' + m + 'm ' + sec + 's';
        if (m > 0) return m + 'm ' + sec + 's';
        return sec + 's';
      }

      function fmtAgo(ms) {
        if (ms == null) return 'never';
        var s = Math.floor(ms / 1000);
        if (s < 60) return s + 's ago';
        var m = Math.floor(s / 60);
        if (m < 60) return m + 'm ago';
        return Math.floor(m / 60) + 'h ' + (m % 60) + 'm ago';
      }

      var heartbeatTimer = null;

      function startHeartbeat() {
        if (heartbeatTimer) return;
        heartbeatTimer = setInterval(function() {
          fetch(GROUP_PATH + '/heartbeat', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (!d.ok) {
                clearInterval(heartbeatTimer);
                heartbeatTimer = null;
              }
            })
            .catch(function() {});
        }, 30000);
      }

      function stopHeartbeat() {
        if (heartbeatTimer) {
          clearInterval(heartbeatTimer);
          heartbeatTimer = null;
        }
      }

      function statusText(m) {
        if (m.studying) return 'Studying ' + fmtDur(Date.now() - m.startMs);
        return 'Last studied ' + fmtAgo(m.lastEndMs == null ? null : Date.now() - m.lastEndMs);
      }

      function render() {
        var me = null;
        for (var i = 0; i < members.length; i++) {
          var m = members[i];
          if (m.userId === ME_ID) me = m;
          var row = document.querySelector('.list-row[data-user="' + m.userId + '"]');
          if (!row) continue;
          var statusEl = row.querySelector('.status');
          if (statusEl) statusEl.textContent = statusText(m);
          var weekEl = row.querySelector('.week');
          if (weekEl) weekEl.textContent = fmtDur(m.weekTotalMs);
          var nudgeBtn = row.querySelector('.nudge-btn');
          if (nudgeBtn) nudgeBtn.style.display = m.studying ? 'none' : 'inline-flex';
        }
        if (me) {
          var timerEl = document.getElementById('timer-status');
          if (timerEl) timerEl.textContent = me.studying
            ? 'Studying · ' + fmtDur(Date.now() - me.startMs)
            : 'Not studying';
          var startBtn = document.getElementById('start-btn');
          var stopBtn = document.getElementById('stop-btn');
          if (startBtn) startBtn.style.display = me.studying ? 'none' : 'inline-flex';
          if (stopBtn) stopBtn.style.display = me.studying ? 'inline-flex' : 'none';
          if (me.studying && !heartbeatTimer) startHeartbeat();
          if (!me.studying && heartbeatTimer) stopHeartbeat();

          // Mini timer bar
          if (me.studying && window.absMiniTimer) {
            window.absMiniTimer.show(me.startMs, GROUP_ID);
          } else if (!me.studying && window.absMiniTimer) {
            window.absMiniTimer.hide();
          }
        }
      }

      function connect() {
        var proto = location.protocol === 'https:' ? 'wss' : 'ws';
        var ws = new WebSocket(proto + '://' + location.host + '/ws/group/' + GROUP_ID);
        ws.onmessage = function(e) {
          var msg = JSON.parse(e.data);
          if (msg.type === 'state') {
            members = msg.members;
          } else if (msg.type === 'update') {
            var found = false;
            for (var i = 0; i < members.length; i++) {
              if (members[i].userId === msg.member.userId) {
                members[i] = msg.member;
                found = true;
                break;
              }
            }
            if (!found) members.push(msg.member);
          }
          render();
        };
        ws.onclose = function() {
          setTimeout(connect, 3000);
        };
      }

      document.getElementById('start-btn').addEventListener('click', function() {
        fetch(GROUP_PATH + '/start', { method: 'POST' }).catch(function() {});
      });
      document.getElementById('stop-btn').addEventListener('click', function() {
        fetch(GROUP_PATH + '/stop', { method: 'POST' }).catch(function() {});
      });

      document.querySelectorAll('.nudge-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetId = btn.getAttribute('data-user');
          var msgEl = btn.parentElement.querySelector('.nudge-msg');
          msgEl.textContent = '';
          fetch(GROUP_PATH + '/nudge/' + targetId, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
              if (d.ok) {
                msgEl.style.color = 'var(--success)';
                msgEl.textContent = 'Nudged!';
              } else {
                msgEl.style.color = 'var(--danger)';
                msgEl.textContent = d.error || 'Failed';
              }
              setTimeout(function() { msgEl.textContent = ''; }, 4000);
            })
            .catch(function() {});
        });
      });

      var notifStatus = document.getElementById('notif-status');
      var notifBtn = document.getElementById('notif-btn');
      var vapidAvailable = false;

      function updateNotifUI(subscribed) {
        if (!('Notification' in window)) {
          notifStatus.textContent = 'Notifications not supported';
          notifBtn.style.display = 'none';
          return;
        }
        if (!vapidAvailable) {
          notifStatus.textContent = 'Push not configured';
          notifBtn.style.display = 'none';
          return;
        }
        if (Notification.permission === 'denied') {
          notifStatus.textContent = 'Notifications blocked';
          notifBtn.style.display = 'none';
        } else if (subscribed) {
          notifStatus.textContent = 'Notifications on';
          notifBtn.textContent = 'Resubscribe';
          notifBtn.style.display = 'inline-flex';
        } else {
          notifStatus.textContent = Notification.permission === 'granted' ? 'Notifications off' : 'Notifications off';
          notifBtn.textContent = 'Turn on notifications';
          notifBtn.style.display = 'inline-flex';
        }
      }

      notifBtn.addEventListener('click', function() {
        if (Notification.permission === 'granted') {
          subscribeForPush();
        } else {
          Notification.requestPermission().then(function(perm) {
            if (perm === 'granted') subscribeForPush();
            updateNotifUI(false);
          });
        }
      });

      function subscribeForPush() {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
        navigator.serviceWorker.register('/sw.js').then(function(reg) {
          fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
            if (!d.key) return;
            vapidAvailable = true;
            var raw = d.key.replace(/-/g, '+').replace(/_/g, '/');
            while (raw.length % 4) raw += '=';
            var u = new Uint8Array(atob(raw).split('').map(function(c) { return c.charCodeAt(0); }));
            reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: u })
              .then(function(sub) {
                fetch('/push/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ endpoint: sub.endpoint, keys: sub.toJSON().keys }),
                }).then(function() { updateNotifUI(true); })
                  .catch(function() { notifStatus.textContent = 'Failed to save subscription'; });
              }).catch(function(e) { notifStatus.textContent = 'Subscription failed: ' + e.message; });
          });
        });
      }

      fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
        vapidAvailable = !!d.key;
        updateNotifUI(false);
      }).catch(function() { notifStatus.textContent = 'Could not check push config'; });

      setInterval(render, 1000);
      render();
      connect();
    })();
  </script>
  <% } %>
<%- include('_layout_close') %>