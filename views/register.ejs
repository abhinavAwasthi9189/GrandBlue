<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head') %>
  <title>abs - Register</title>
</head>
<body>
  <h1>Register</h1>
  <% if (locals.error) { %>
    <p style="color:red"><%= error %></p>
  <% } %>
  <form method="POST">
    <% if (locals.signupCodeRequired) { %>
      <p><input name="signup_code" placeholder="Signup code" required></p>
    <% } %>
    <p><input name="username" placeholder="Username" autocomplete="username" required></p>
    <p><input name="password" type="password" placeholder="Password" autocomplete="new-password" required></p>
    <p><button>Register</button></p>
  </form>
  <p><a href="/login">Log in</a></p>
</body>
</html>