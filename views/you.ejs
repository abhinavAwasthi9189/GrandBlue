<!DOCTYPE html>
<html lang="en">
<head>
<%- include('_layout', { title: 'You', page: 'you', wide: true }) %>
<% var hash = 0; for (var i = 0; i < String(session.userId).length; i++) { hash = ((hash << 5) - hash) + String(session.userId).charCodeAt(i); hash |= 0; } %>
<% var hue = ((hash % 360) + 360) % 360; %>
<div id="you-page">
  <!-- Header -->
  <div style="display:flex;align-items:center;gap:var(--space-lg);margin-bottom:var(--space-xl);padding:var(--space-lg) 0">
    <% if (locals.hasAvatar) { %>
      <img src="/avatar/<%= session.userId %>" alt="" style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex-shrink:0">
    <% } else { %>
    <div class="avatar avatar-lg" style="background:hsl(<%= hue %>, 55%, 50%);width:64px;height:64px;font-size:var(--font-2xl)"><%= username.charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <div style="font-size:var(--font-xl);font-weight:700"><%= username %></div>
      <div style="font-size:var(--font-sm);color:var(--text-secondary)">Member of <%= membershipCount %> group<%= membershipCount !== 1 ? 's' : '' %></div>
    </div>
  </div>

  <div class="you-split">
  <!-- Study section -->
  <div class="card" style="margin-bottom:var(--space-lg)">
    <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">Study</h2>
    <div class="you-stats-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-md);margin-bottom:var(--space-lg)">
      <div><div style="font-size:var(--font-sm);color:var(--text-secondary)">Today</div><div class="stat-value" id="stat-today">—</div></div>
      <div><div style="font-size:var(--font-sm);color:var(--text-secondary)">This week</div><div class="stat-value" id="stat-week">—</div></div>
      <div><div style="font-size:var(--font-sm);color:var(--text-secondary)">Streak</div><div class="stat-value" id="stat-streak">—</div></div>
      <div><div style="font-size:var(--font-sm);color:var(--text-secondary)">Best week</div><div class="stat-value" id="stat-best">—</div></div>
    </div>
    <div style="margin-bottom:var(--space-lg)">
      <div style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-sm)">Last 8 weeks</div>
      <canvas id="chart-8weeks" height="140"></canvas>
    </div>
    <div>
      <div style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-sm)">Last 7 days</div>
      <canvas id="chart-7days" height="140"></canvas>
    </div>
  </div>

  <!-- LeetCode section -->
  <div class="card" style="margin-bottom:var(--space-lg)">
    <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">LeetCode</h2>
    <% if (!hasLeetcode) { %>
      <p style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-md)">
        Link your LeetCode account to track solved problems, earn XP, and compete on the weekly leaderboard.
      </p>
      <form id="lc-form">
        <div style="display:flex;gap:var(--space-sm)">
          <input id="lc-input" name="leetcode_username" placeholder="LeetCode username" required
            style="flex:1;padding:12px 14px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px">
          <button class="btn btn-primary" type="submit">Link</button>
        </div>
        <span id="lc-msg" style="font-size:var(--font-sm);margin-top:var(--space-sm);display:block"></span>
      </form>
    <% } else { %>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-md)">
        <div>
          <span class="chip chip-success" style="margin-right:var(--space-sm)">✓ Linked</span>
          <strong id="lc-username"><%= leetcodeUsername %></strong>
        </div>
        <div style="display:flex;gap:var(--space-sm)">
          <button class="btn btn-sm btn-secondary" id="lc-change-btn" type="button">Change</button>
          <button class="btn btn-sm btn-danger" id="lc-unlink-btn" type="button">Unlink</button>
        </div>
      </div>
      <form id="lc-form" style="display:none;margin-bottom:var(--space-md)">
        <div style="display:flex;gap:var(--space-sm)">
          <input id="lc-input" name="leetcode_username" value="<%= leetcodeUsername %>" placeholder="LeetCode username" required
            style="flex:1;padding:10px 12px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius-md);color:var(--text-primary);font-size:16px">
          <button class="btn btn-sm btn-primary" type="submit">Save</button>
        </div>
        <span id="lc-msg" style="font-size:var(--font-sm);margin-top:var(--space-sm);display:block"></span>
      </form>

      <div id="lc-stats">
        <div style="display:flex;gap:var(--space-md);margin-bottom:var(--space-md)">
          <div><span class="chip chip-accent" id="lc-easy">Easy 0</span></div>
          <div><span class="chip chip-warning" id="lc-medium">Medium 0</span></div>
          <div><span class="chip chip-danger" id="lc-hard">Hard 0</span></div>
          <div style="margin-left:auto;font-family:var(--font-mono);font-weight:600" id="lc-xp">0 XP</div>
        </div>
        <div style="margin-bottom:var(--space-md)">
          <div style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-sm)">Solves this week</div>
          <canvas id="chart-lc-week" height="120"></canvas>
        </div>
        <div>
          <div style="font-size:var(--font-sm);color:var(--text-secondary);margin-bottom:var(--space-sm)">Last 5 solves</div>
          <div id="lc-recent"></div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Settings -->
  <div class="card" style="margin-bottom:var(--space-xl)">
    <h2 style="font-size:var(--font-lg);font-weight:600;margin-bottom:var(--space-md)">Settings</h2>
    <div class="list-row">
      <div class="row-main"><div class="row-label">Notifications</div><div class="row-sub" id="notif-status-text">Checking…</div></div>
      <button class="btn btn-sm btn-secondary" id="notif-settings-btn" style="display:none">Enable</button>
    </div>
    <div class="list-row">
      <div class="row-main"><div class="row-label">Install app</div><div class="row-sub">Add to Home Screen</div></div>
      <button class="btn btn-sm btn-secondary" id="install-btn">Install</button>
    </div>
    <div class="list-row">
      <div class="row-main"><div class="row-label">Change password</div></div>
      <a href="/change-password" class="btn btn-sm btn-secondary">Change</a>
    </div>
    <div class="list-row">
      <div class="row-main"><div class="row-label">Log out</div></div>
      <a href="/logout" class="btn btn-sm btn-danger">Log out</a>
    </div>
  </div>
  </div>
</div>

<script src="/vendor/chart.umd.min.js"></script>
<script>
(function() {
  var userId = <%= session.userId %>;

  function fmtDur(ms) {
    if (ms < 0) ms = 0;
    var s = Math.floor(ms / 1000);
    var h = Math.floor(s / 3600);
    var m = Math.floor((s % 3600) / 60);
    if (h > 0) return h + 'h ' + m + 'm';
    if (m > 0) return m + 'm ' + (s % 60) + 's';
    return s + 's';
  }

  function fmtDays(d) { return d + (d === 1 ? ' day' : ' days'); }

  // --- LeetCode form ---
  var lcForm = document.getElementById('lc-form');
  var lcInput = document.getElementById('lc-input');
  var lcMsg = document.getElementById('lc-msg');

  if (lcForm) {
    lcForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var val = lcInput.value.trim();
      if (!val) return;
      if (lcMsg) { lcMsg.style.color = ''; lcMsg.textContent = 'Checking...'; }
      fetch('/profile/leetcode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ leetcode_username: val }),
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) { location.reload(); }
        else { if (lcMsg) { lcMsg.style.color = 'var(--danger)'; lcMsg.textContent = d.error || 'Error'; } }
      }).catch(function() {
        if (lcMsg) { lcMsg.style.color = 'var(--danger)'; lcMsg.textContent = 'Network error'; }
      });
    });
  }

  var changeBtn = document.getElementById('lc-change-btn');
  if (changeBtn) {
    changeBtn.addEventListener('click', function() { lcForm.style.display = ''; changeBtn.style.display = 'none'; });
  }

  var unlinkBtn = document.getElementById('lc-unlink-btn');
  if (unlinkBtn) {
    unlinkBtn.addEventListener('click', function() {
      fetch('/profile/leetcode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ leetcode_username: '' }),
      }).then(function(r) { return r.json(); }).then(function(d) { if (d.ok) location.reload(); });
    });
  }

  // --- Fetch stats ---
  fetch('/api/me/stats')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (!d.ok) throw new Error('API error');

      document.getElementById('stat-today').textContent = fmtDur(d.today.totalMs);
      document.getElementById('stat-week').textContent = fmtDur(d.thisWeek.totalMs);
      document.getElementById('stat-streak').textContent = fmtDays(d.streak);
      document.getElementById('stat-best').textContent = fmtDur(d.bestWeekMs);

      // 8-week chart
      var wkLabels = d.last8Weeks.map(function(w) {
        var d2 = new Date(w.weekStart + 5.5 * 3600000);
        return d2.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
      });
      var wkData = d.last8Weeks.map(function(w) { return Math.round(w.totalMs / 60000); });
      new Chart(document.getElementById('chart-8weeks'), {
        type: 'bar',
        data: { labels: wkLabels, datasets: [{ data: wkData, backgroundColor: 'rgba(99,102,241,0.6)', borderRadius: 4 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: '#9898a8', font: { size: 10 } }, grid: { display: false } },
            y: { beginAtZero: true, ticks: { color: '#9898a8', font: { size: 10 }, callback: function(v) { return v + 'm'; } }, grid: { color: '#2e2e3a' } }
          }
        }
      });

      // 7-day study chart
      var dayLabels = d.last7Days.map(function(d2) { return d2.label; });
      var dayData = d.last7Days.map(function(d2) { return Math.round(d2.totalMs / 60000); });
      new Chart(document.getElementById('chart-7days'), {
        type: 'bar',
        data: { labels: dayLabels, datasets: [{ data: dayData, backgroundColor: 'rgba(99,102,241,0.6)', borderRadius: 4 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: '#9898a8', font: { size: 10 } }, grid: { display: false } },
            y: { beginAtZero: true, ticks: { color: '#9898a8', font: { size: 10 }, callback: function(v) { return v + 'm'; } }, grid: { color: '#2e2e3a' } }
          }
        }
      });

      // LeetCode stats
      if (d.leetcode) {
        var lc = d.leetcode;
        document.getElementById('lc-easy').textContent = 'Easy ' + lc.byDifficulty.Easy;
        document.getElementById('lc-medium').textContent = 'Medium ' + lc.byDifficulty.Medium;
        document.getElementById('lc-hard').textContent = 'Hard ' + lc.byDifficulty.Hard;
        document.getElementById('lc-xp').textContent = lc.xpThisWeek + ' XP';

        // LC 7-day chart
        if (lc.weekSolves7) {
          new Chart(document.getElementById('chart-lc-week'), {
            type: 'bar',
            data: {
              labels: lc.weekSolves7.map(function(s) { return s.label; }),
              datasets: [{
                data: lc.weekSolves7.map(function(s) { return s.count; }),
                backgroundColor: 'rgba(34,197,94,0.6)', borderRadius: 4
              }]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { ticks: { color: '#9898a8', font: { size: 10 } }, grid: { display: false } },
                y: { beginAtZero: true, ticks: { color: '#9898a8', font: { size: 10 }, stepSize: 1 }, grid: { color: '#2e2e3a' } }
              }
            }
          });
        }

        // Last 5 solves
        var recentEl = document.getElementById('lc-recent');
        if (lc.last5Solves.length === 0) {
          recentEl.innerHTML = '<span class="text-secondary" style="font-size:var(--font-sm)">No solves this week yet.</span>';
        } else {
          recentEl.innerHTML = lc.last5Solves.map(function(s) {
            var diffClass = s.difficulty === 'Easy' ? 'chip-accent' : s.difficulty === 'Medium' ? 'chip-warning' : 'chip-danger';
            return '<div style="display:flex;align-items:center;gap:var(--space-sm);padding:4px 0;font-size:var(--font-sm)">' +
              '<a href="https://leetcode.com/problems/' + s.slug + '/" target="_blank">' + s.slug + '</a>' +
              ' <span class="chip ' + diffClass + '" style="font-size:10px;padding:1px 6px">' + s.difficulty + '</span>' +
              '</div>';
          }).join('');
        }
      }
    })
.catch(function() {
      var els = ['stat-today', 'stat-week', 'stat-streak', 'stat-best'];
      els.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.textContent = '-';
      });
    });

  // --- Notifications in settings ---
  var notifStatus = document.getElementById('notif-status-text');
  var notifBtn = document.getElementById('notif-settings-btn');

  function updateNotifUI(state) {
    if (!('Notification' in window)) { notifStatus.textContent = 'Not supported'; notifBtn.style.display = 'none'; return; }
    if (!state.vapidConfigured) { notifStatus.textContent = 'Push not configured'; notifBtn.style.display = 'none'; return; }
    if (Notification.permission === 'denied') {
      notifStatus.textContent = 'Blocked';
      notifBtn.style.display = 'none';
    } else if (state.subscribed) {
      notifStatus.textContent = 'On';
      notifBtn.textContent = 'Turn off';
      notifBtn.style.display = 'inline-flex';
    } else {
      notifStatus.textContent = 'Off';
      notifBtn.textContent = 'Turn on';
      notifBtn.style.display = 'inline-flex';
    }
  }

  if (notifBtn) {
    notifBtn.addEventListener('click', function() {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
      var turningOn = notifBtn.textContent === 'Turn on';
      if (!turningOn) {
        navigator.serviceWorker.ready.then(function(reg) {
          reg.pushManager.getSubscription().then(function(sub) {
            if (!sub) return;
            fetch('/push/unsubscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ endpoint: sub.endpoint }),
            }).then(function() {
              sub.unsubscribe();
              updateNotifUI({ subscribed: false, vapidConfigured: true });
            }).catch(function() {});
          });
        });
        return;
      }
      if (Notification.permission !== 'granted') {
        Notification.requestPermission().then(function(p) {
          if (p === 'granted') doSubscribe();
        });
      } else {
        doSubscribe();
      }
    });
  }

  function base64ToUint8(b64) {
    var raw = b64.replace(/-/g, '+').replace(/_/g, '/');
    while (raw.length % 4) raw += '=';
    return new Uint8Array(atob(raw).split('').map(function(c) { return c.charCodeAt(0); }));
  }

  function doSubscribe() {
    // Check secure context
    if (location.protocol !== 'https:' && location.hostname !== 'localhost') {
      notifStatus.textContent = 'HTTPS required — use https://friday.tailc9d480.ts.net';
      notifBtn.style.display = 'inline-flex';
      return;
    }
    navigator.serviceWorker.register('/sw.js').then(function(reg) {
      fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
        if (!d.key) { notifStatus.textContent = 'Push not configured'; return; }
        var u = base64ToUint8(d.key);
        // Unsubscribe any stale subscription first (e.g. from a different VAPID key)
        reg.pushManager.getSubscription().then(function(oldSub) {
          if (oldSub) {
            return fetch('/push/unsubscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ endpoint: oldSub.endpoint }),
            }).then(function() { return oldSub.unsubscribe(); });
          }
        }).then(function() {
          return reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: u });
        }).then(function(sub) {
          return fetch('/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ endpoint: sub.endpoint, keys: sub.toJSON().keys }),
          }).then(function(r) { return r.json(); });
        }).then(function() {
          updateNotifUI({ subscribed: true, vapidConfigured: true });
        }).catch(function(e) {
          notifStatus.textContent = 'Subscription failed: ' + (e.message || 'unknown');
          notifBtn.style.display = 'inline-flex';
        });
        }).catch(function() { notifStatus.textContent = 'VAPID fetch failed'; });
      }).catch(function() { notifStatus.textContent = 'SW registration failed'; });
  }

  fetch('/push/status').then(function(r) { return r.json(); }).then(function(state) {
    updateNotifUI(state);
    console.log('abs: protocol=' + location.protocol + ' push=' + (state.vapidConfigured ? 'ready' : 'no-vapid') + ' subscribed=' + state.subscribed);

    if (state.vapidConfigured && !state.subscribed && 'Notification' in window && Notification.permission === 'granted') {
      navigator.serviceWorker.ready.then(function(reg) {
        reg.pushManager.getSubscription().then(function(sub) {
          if (sub) {
            fetch('/push/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ endpoint: sub.endpoint, keys: sub.toJSON().keys }),
            }).then(function(r) { return r.json(); }).then(function() {
              updateNotifUI({ subscribed: true, vapidConfigured: true });
            });
          } else {
            doSubscribe();
          }
        });
      });
    }
  }).catch(function() { notifStatus.textContent = 'Unavailable'; });

  // Handle pushsubscriptionchange — re-subscribe and save new endpoint
  if ('serviceWorker' in navigator && 'PushManager' in window) {
    navigator.serviceWorker.ready.then(function(reg) {
      reg.pushManager.addEventListener('pushsubscriptionchange', function() {
        fetch('/push/vapid-public-key').then(function(r) { return r.json(); }).then(function(d) {
          if (!d.key) return;
          var u = base64ToUint8(d.key);
          reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: u })
            .then(function(sub) {
              fetch('/push/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ endpoint: sub.endpoint, keys: sub.toJSON().keys }),
              });
            });
        });
      });
    });
  }

  // Delete push subscriptions on logout
  var logoutLink = document.querySelector('a[href="/logout"]');
  if (logoutLink) {
    logoutLink.addEventListener('click', function() {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.ready.then(function(reg) {
          reg.pushManager.getSubscription().then(function(sub) {
            if (sub) {
              fetch('/push/unsubscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ endpoint: sub.endpoint }),
              }).then(function() { sub.unsubscribe(); });
            }
          });
        });
      }
    });
  }

  // --- Install prompt ---
  var installBtn = document.getElementById('install-btn');
  var deferredPrompt = null;
  var installShown = localStorage.getItem('abs-install-shown');
  window.addEventListener('beforeinstallprompt', function(e) {
    e.preventDefault();
    deferredPrompt = e;
    if (installShown !== '1') { installBtn.style.display = 'inline-flex'; }
    installBtn.onclick = function() {
      installBtn.style.display = 'none';
      localStorage.setItem('abs-install-shown', '1');
      deferredPrompt.prompt();
    };
  });
  var isiOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  if (isiOS) {
    if (installShown !== '1') { installBtn.style.display = 'inline-flex'; }
    installBtn.onclick = function() {
      installBtn.style.display = 'none';
      localStorage.setItem('abs-install-shown', '1');
      alert('Tap Share → Add to Home Screen');
    };
  }
// --- Profile photo (long-press / click crop) ---
  var avatarWrapper = document.querySelector('#you-page img[src^="/avatar/"]') || document.querySelector('#you-page .avatar.avatar-lg') || document.querySelector('#you-page .avatar');
  var fileInput = document.createElement('input');
  fileInput.type = 'file'; fileInput.accept = 'image/*';

  // Support both long-press (mobile) and click (desktop)
  var longPressTimer = null;
  var suppressClick = false;
  if (avatarWrapper) {
    avatarWrapper.addEventListener('touchstart', function() {
      suppressClick = false;
      longPressTimer = setTimeout(function() { suppressClick = true; fileInput.click(); }, 500);
    });
    avatarWrapper.addEventListener('touchend', function() { clearTimeout(longPressTimer); });
    avatarWrapper.addEventListener('touchmove', function() { clearTimeout(longPressTimer); });
    avatarWrapper.addEventListener('click', function() { if (!suppressClick) fileInput.click(); });
  }

  var cropDialog = document.getElementById('crop-dialog');
  var cropCanvas = document.getElementById('crop-canvas');
  var cropCtx = cropCanvas.getContext('2d');
  var zoomSlider = document.getElementById('zoom-slider');

  var cropImg = null;       // HTMLImageElement after load
  var cropOffsetX = 0, cropOffsetY = 0;
  var cropZoom = 1;
  var dragStartX = 0, dragStartY = 0;
  var isDragging = false;

  function drawCrop() {
    if (!cropImg) return;
    var s = 256;
    cropCanvas.width = s; cropCanvas.height = s;
    cropCtx.clearRect(0, 0, s, s);
    var scale = Math.max(s / cropImg.width, s / cropImg.height) * cropZoom;
    var dw = cropImg.width * scale;
    var dh = cropImg.height * scale;
    var dx = (s - dw) / 2 + cropOffsetX;
    var dy = (s - dh) / 2 + cropOffsetY;
    cropCtx.beginPath();
    cropCtx.arc(s / 2, s / 2, s / 2, 0, Math.PI * 2);
    cropCtx.clip();
    cropCtx.drawImage(cropImg, dx, dy, dw, dh);
  }

  fileInput.addEventListener('change', function() {
    var file = fileInput.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function() {
      var img = new Image();
      img.onload = function() {
        cropImg = img;
        cropOffsetX = 0; cropOffsetY = 0;
        cropZoom = 1;
        zoomSlider.value = 1;
        cropDialog.style.display = 'flex';
        drawCrop();
      };
      img.src = reader.result;
    };
    reader.onerror = function() {};
    reader.readAsDataURL(file);
    fileInput.value = '';
  });

  // Zoom slider
  zoomSlider.addEventListener('input', function() {
    cropZoom = parseFloat(zoomSlider.value);
    drawCrop();
  });

  // Drag to pan
  cropCanvas.addEventListener('mousedown', function(e) {
    isDragging = true;
    dragStartX = e.clientX - cropOffsetX;
    dragStartY = e.clientY - cropOffsetY;
    cropCanvas.style.cursor = 'grabbing';
  });
  cropCanvas.addEventListener('touchstart', function(e) {
    var t = e.touches[0];
    isDragging = true;
    dragStartX = t.clientX - cropOffsetX;
    dragStartY = t.clientY - cropOffsetY;
  });
  function onDrag(e) {
    if (!isDragging) return;
    var cx, cy;
    if (e.touches) { cx = e.touches[0].clientX; cy = e.touches[0].clientY; }
    else { cx = e.clientX; cy = e.clientY; }
    cropOffsetX = cx - dragStartX;
    cropOffsetY = cy - dragStartY;
    drawCrop();
  }
  cropCanvas.addEventListener('mousemove', onDrag);
  cropCanvas.addEventListener('touchmove', onDrag);
  function endDrag() { isDragging = false; cropCanvas.style.cursor = 'grab'; }
  cropCanvas.addEventListener('mouseup', endDrag);
  cropCanvas.addEventListener('touchend', endDrag);

  // Save
  document.getElementById('crop-save').addEventListener('click', function() {
    var dataUrl = cropCanvas.toDataURL();
    fetch('/avatar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ image: dataUrl }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) { location.reload(); }
    }).catch(function() {});
  });

  function closeCrop() { cropDialog.style.display = 'none'; cropImg = null; }
  document.getElementById('crop-close').addEventListener('click', closeCrop);
  document.getElementById('crop-cancel').addEventListener('click', closeCrop);
  cropDialog.addEventListener('click', function(e) { if (e.target === cropDialog) closeCrop(); });

})();
</script>

<!-- Crop dialog -->
<div class="dialog-overlay" id="crop-dialog" style="display:none">
  <div class="dialog-content" style="max-width:360px">
    <div class="dialog-header">
      <div class="dialog-title">Set profile photo</div>
      <button class="dialog-close" id="crop-close">✕</button>
    </div>
    <div style="width:256px;height:256px;margin:0 auto var(--space-md);border-radius:50%;overflow:hidden;position:relative;background:var(--bg-tertiary)" id="crop-stage">
      <canvas id="crop-canvas" width="256" height="256" style="position:absolute;top:0;left:0;width:256px;height:256px;cursor:grab;touch-action:none"></canvas>
    </div>
    <div style="margin-bottom:var(--space-md)">
      <input type="range" id="zoom-slider" min="1" max="3" step="0.05" value="1" style="width:100%;accent-color:var(--accent)">
    </div>
    <div class="dialog-actions">
      <button class="btn btn-secondary" id="crop-cancel">Cancel</button>
      <button class="btn btn-primary" id="crop-save" style="flex:1">Save</button>
    </div>
  </div>
</div>

<%- include('_layout_close') %>