<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head') %>
  <title>abs - Home</title>
</head>
<body>
  <h1>Home</h1>
  <p>Logged in as <strong><%= session.username %></strong></p>
  <p><a href="/create-group">Create Group</a> | <a href="/logout">Log out</a></p>

  <% if (locals.error) { %>
    <p style="color:red"><%= error %></p>
  <% } %>

  <h2>My Groups</h2>
  <% if (myGroups.length === 0) { %>
    <p><em>No groups yet.</em></p>
  <% } else { %>
    <ul>
    <% myGroups.forEach(function(g) { %>
      <li><a href="/group/<%= g.id %>"><%= g.name %></a> (<%= g.role %>)</li>
    <% }); %>
    </ul>
  <% } %>

  <h2>Pending Invites</h2>
  <% if (pendingInvites.length === 0) { %>
    <p><em>No pending invites.</em></p>
  <% } else { %>
    <ul>
    <% pendingInvites.forEach(function(g) { %>
      <li>
        <strong><%= g.name %></strong>
        <form method="POST" action="/invite/<%= g.id %>/accept" style="display:inline">
          <button>Accept</button>
        </form>
        <form method="POST" action="/invite/<%= g.id %>/decline" style="display:inline">
          <button>Decline</button>
        </form>
      </li>
    <% }); %>
    </ul>
  <% } %>

  <h2>Requested (waiting for approval)</h2>
  <% if (pendingRequests.length === 0) { %>
    <p><em>None.</em></p>
  <% } else { %>
    <ul>
    <% pendingRequests.forEach(function(g) { %>
      <li><%= g.name %> - <em>pending approval</em></li>
    <% }); %>
    </ul>
  <% } %>

  <div id="install-prompt" style="display:none;position:fixed;bottom:0;left:0;right:0;background:#6366f1;color:#fff;padding:16px;text-align:center;z-index:999">
    <p style="margin:0 0 8px"><strong>Install abs</strong> for the best experience</p>
    <button id="install-btn" style="background:#fff;color:#6366f1;border:none;padding:8px 24px;border-radius:6px;font-weight:600;cursor:pointer">Install</button>
    <button id="install-dismiss" style="background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.5);padding:8px 24px;border-radius:6px;margin-left:8px;cursor:pointer">Not now</button>
  </div>

  <script>
    (function() {
      if (window.navigator.standalone) return;

      var KEY = 'pwa-shown';
      if (localStorage.getItem(KEY)) return;

      var deferredPrompt = null;
      var promptEl = document.getElementById('install-prompt');
      var installBtn = document.getElementById('install-btn');
      var dismissBtn = document.getElementById('install-dismiss');

      function hide() {
        promptEl.style.display = 'none';
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      }

      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        deferredPrompt = e;
        promptEl.style.display = 'block';
      });

      installBtn.addEventListener('click', function() {
        hide();
        if (deferredPrompt) {
          deferredPrompt.prompt();
          deferredPrompt.userChoice.then(function() { deferredPrompt = null; });
        }
      });

      dismissBtn.addEventListener('click', hide);

      // iOS fallback
      var isiOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      if (isiOS) {
        promptEl.innerHTML =
          '<p style="margin:0 0 8px"><strong>Install abs</strong><br>Tap <strong>Share</strong> <span style="font-size:20px">⎋</span> then <strong>Add to Home Screen</strong></p>' +
          '<button id="install-dismiss" style="background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.5);padding:8px 24px;border-radius:6px;cursor:pointer">Got it</button>';
        promptEl.style.display = 'block';
        document.getElementById('install-dismiss').addEventListener('click', hide);
      }
    })();
  </script>
</body>
</html>