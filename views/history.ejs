<%
function formatDur(ms) {
  ms = Math.max(0, ms);
  var s = Math.floor(ms / 1000);
  var h = Math.floor(s / 3600);
  var m = Math.floor((s % 3600) / 60);
  if (h > 0) return h + 'h ' + m + 'm';
  if (m > 0) return m + 'm ' + (s % 60) + 's';
  return s + 's';
}
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('_layout', { title: group.name + ' history', page: 'groups', wide: true }) %>
  <div style="display:flex;align-items:center;gap:var(--space-md);margin-bottom:var(--space-lg)">
    <a href="/group/<%= group.id %>" class="btn btn-ghost btn-sm" style="font-size:1.2rem;padding:4px 8px">←</a>
    <h1 style="font-size:var(--font-xl);font-weight:700"><%= group.name %> — Study history</h1>
  </div>

  <% if (members.length === 0) { %>
    <div class="empty-state"><div class="empty-state-text">No members in this group.</div></div>
  <% } else { %>
    <div class="card" style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:var(--font-sm)">
        <tr style="border-bottom:1px solid var(--border)">
          <th style="text-align:left;padding:var(--space-sm) var(--space-md);font-weight:600">Week</th>
          <% members.forEach(function(name) { %><th style="text-align:right;padding:var(--space-sm) var(--space-md);font-weight:600"><%= name %></th><% }); %>
        </tr>
        <% weeks.forEach(function(w) { %>
          <tr style="border-bottom:1px solid var(--border-light)">
            <td style="padding:var(--space-sm) var(--space-md)"><%= w.label %></td>
            <% w.totals.forEach(function(t) { %>
              <td style="text-align:right;padding:var(--space-sm) var(--space-md);font-family:var(--font-mono)"><%= formatDur(t.total_ms) %></td>
            <% }); %>
          </tr>
        <% }); %>
      </table>
    </div>

    <div style="display:flex;justify-content:center;gap:var(--space-md);margin-top:var(--space-lg)">
      <% if (page > 0) { %>
        <a href="/group/<%= group.id %>/history?page=<%= page - 1 %>" class="btn btn-sm btn-secondary">‹ Newer weeks</a>
      <% } else { %>
        <span class="btn btn-sm btn-secondary" style="opacity:0.4;cursor:default">‹ Newer weeks</span>
      <% } %>
      <a href="/group/<%= group.id %>/history?page=<%= page + 1 %>" class="btn btn-sm btn-secondary">Older weeks ›</a>
    </div>
    <p style="text-align:center;margin-top:var(--space-md);font-size:var(--font-sm);color:var(--text-tertiary)">Weeks run Monday 00:00 to Sunday 23:59 IST.</p>
  <% } %>
<%- include('_layout_close') %>